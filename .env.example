# Optional multiplayer API endpoint
VITE_API_ENDPOINT=

# Optional release identifier (for logs/errors)
VITE_RELEASE=

# Optional log verbosity: debug|info|warn|error
VITE_LOG_LEVEL=info

# Optional explicit debug toggle (true/false)
VITE_DEBUG_MODE=false

# Optional error ingestion endpoint
VITE_ERROR_REPORTING_ENDPOINT=

# Optional game analytics endpoint
VITE_ANALYTICS_ENDPOINT=
