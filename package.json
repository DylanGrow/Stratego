{
  "name": "stratego-game",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first Stratego game with TypeScript and PWA support",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "quality-gate": "npm run lint && npm run type-check && npm run test:coverage && npm run build",
    "quality-gate:e2e": "npm run quality-gate && npm run test:e2e",
    "format": "prettier --write .",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "generate-headers": "tsx scripts/generate-headers.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@vitest/coverage-v8": "^4.0.7",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.0.7"
  }
}
